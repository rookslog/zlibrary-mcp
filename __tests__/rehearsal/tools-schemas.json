[
  {
    "name": "download",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "output_dir": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "path",
            "bytes",
            "reused",
            "transfer_skipped",
            "verified",
            "record",
            "source"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "reused": {
              "type": "boolean"
            },
            "transfer_skipped": {
              "type": "boolean"
            },
            "verified": {
              "const": "sha256"
            },
            "record": {
              "type": "string"
            },
            "quota_estimate": {
              "type": "object"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": [
                    "safe",
                    "may_spend_quota",
                    "no"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "get_book",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "ref",
            "source",
            "identifiers",
            "evidence"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "identifiers": {
              "type": "object"
            },
            "evidence": {
              "type": "object"
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": [
                    "safe",
                    "may_spend_quota",
                    "no"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "get_history",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "libgen",
            "zlibrary",
            "annas"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "rows"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "next_cursor": {
              "type": "string"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": [
                    "safe",
                    "may_spend_quota",
                    "no"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "get_limits",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sources": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "libgen",
              "zlibrary",
              "annas"
            ]
          },
          "uniqueItems": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "local",
            "live"
          ]
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "sources",
            "search"
          ],
          "properties": {
            "sources": {
              "type": "object",
              "properties": {
                "annas": {
                  "type": "object",
                  "required": [
                    "member_key_configured",
                    "member_session"
                  ],
                  "properties": {
                    "member_key_configured": {
                      "type": "boolean"
                    },
                    "member_session": {
                      "enum": [
                        "none",
                        "active",
                        "rejected"
                      ]
                    }
                  }
                }
              }
            },
            "search": {
              "type": "object",
              "required": [
                "default_sources",
                "wait_ms",
                "ordering"
              ]
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": [
                    "safe",
                    "may_spend_quota",
                    "no"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "search",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sources": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "libgen",
              "zlibrary",
              "annas"
            ]
          },
          "uniqueItems": true
        },
        "exact": {
          "description": "Local per-field phrase check on every source; also sent to Z-Library.",
          "type": "boolean"
        },
        "year_from": {
          "description": "Inclusive minimum year; checked on every source. Unknown years are excluded and counted.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "year_to": {
          "description": "Inclusive maximum year; checked on every source. Unknown years are excluded and counted.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "languages": {
          "description": "OR of names/codes; checked on every source. Unknown metadata is excluded. Empty list adds no constraint.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "description": "OR of extensions, case-insensitive, one leading dot ignored; checked on every source. Empty list adds no constraint.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "rows",
            "sources",
            "all_answered",
            "ordering",
            "note"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "ref",
                  "source",
                  "match"
                ],
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "match": {
                    "enum": [
                      "exact_title",
                      "all_terms",
                      "source_only"
                    ]
                  },
                  "other_copies": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "ref",
                        "source"
                      ],
                      "properties": {
                        "ref": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        },
                        "filter": {
                          "enum": [
                            "pass",
                            "fail",
                            "unknown"
                          ]
                        },
                        "unknown": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "route_basis": {
                    "enum": [
                      "only_usable",
                      "operator_order",
                      "stable_tie"
                    ]
                  },
                  "differs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "likely_group": {
                    "type": "string"
                  },
                  "likely_same_file_as": {
                    "type": "string"
                  },
                  "download_available": {
                    "const": false
                  }
                },
                "if": {
                  "required": [
                    "other_copies"
                  ]
                },
                "then": {
                  "required": [
                    "route_basis"
                  ]
                }
              }
            },
            "sources": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "state",
                      "rows",
                      "ms"
                    ],
                    "properties": {
                      "state": {
                        "const": "rows"
                      },
                      "rows": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "state",
                      "rows",
                      "ms"
                    ],
                    "properties": {
                      "state": {
                        "const": "empty"
                      },
                      "rows": {
                        "const": 0
                      },
                      "ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "state",
                      "ms"
                    ],
                    "properties": {
                      "state": {
                        "const": "late"
                      },
                      "ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "state",
                      "code",
                      "reason",
                      "ms"
                    ],
                    "properties": {
                      "state": {
                        "const": "failed"
                      },
                      "code": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "state",
                      "reason"
                    ],
                    "properties": {
                      "state": {
                        "const": "not_asked"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "retry_after_s": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            },
            "all_answered": {
              "type": "boolean"
            },
            "ordering": {
              "const": "fit-v1"
            },
            "note": {
              "type": "string"
            },
            "next_cursor": {
              "type": "string"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": [
                    "safe",
                    "may_spend_quota",
                    "no"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  }
]
