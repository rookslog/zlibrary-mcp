# Z-Library MCP Server Environment Configuration
# Copy this file to .env and fill in your credentials

# Required: Z-Library account credentials
ZLIBRARY_EMAIL=your@email.com
ZLIBRARY_PASSWORD=your_password_here

# Optional: Custom Z-Library mirror URL
# ZLIBRARY_MIRROR=https://your-mirror.example

# Optional: Anna's Archive API key (from donation)
# Get your key at: https://annas-archive.li/donate
ANNAS_SECRET_KEY=your_secret_key_here

# Optional: Anna's Archive mirror (if main domain is down)
# ANNAS_BASE_URL=https://annas-archive.li

# Optional: LibGen mirror extension (li, bz, gs, etc.)
# LIBGEN_MIRROR=li

# Optional: Source deadlines (seconds unless marked milliseconds)
# One shared search or download-resolution walk across configured mirrors;
# no fixed mirror-count cap. Skipped mirrors report walk_budget_exhausted.
# Raise this budget if needed; if already clamped, raise its bridge owner.
# Each source search child has its own walk, not a whole-tool search deadline.
# BOOK_SOURCE_WALK_BUDGET=165
# DNS and TCP preflight share this one aggregate budget.
# BOOK_SOURCE_PREFLIGHT_TIMEOUT=5
# Source resolution + transfer chain: base 1500s, size-scaled up to 3600s.
# Resolution is inside the chain; do not add its walk budget again.
# The floor is an allowance calculation, not a minimum-speed cutoff.
# BOOK_SOURCE_DOWNLOAD_TIMEOUT=1500
# BOOK_SOURCE_DOWNLOAD_FLOOR_SPEED=40960
# BOOK_SOURCE_DOWNLOAD_TIMEOUT_CEILING=3600
# Effective ceiling is at least the base; both are clamped below the bridge owner.
# Owners are in milliseconds; source walks reject valid positive values below
# 10000 before provider contact. Malformed timer values use the defaults.
# PYTHON_BRIDGE_TIMEOUT=240000
# PYTHON_BRIDGE_LONG_TIMEOUT=3900000
# Overhead and acquisition finalization reserves also reduce available time.
# See docs/RETRY_CONFIGURATION.md for clamping and acquisition deadline details.

# Optional: Retry configuration
# RETRY_MAX_RETRIES=3
# RETRY_INITIAL_DELAY=1000
# RETRY_MAX_DELAY=30000

# Optional: Circuit breaker configuration
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT=60000
