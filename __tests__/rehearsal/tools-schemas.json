[
  {
    "name": "download",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "output_dir": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": ["path", "bytes", "reused", "transfer_skipped", "verified", "record"],
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "reused": {
              "type": "boolean"
            },
            "transfer_skipped": {
              "type": "boolean"
            },
            "verified": {
              "const": "sha256"
            },
            "record": {
              "type": "string"
            },
            "quota_estimate": {
              "type": "object"
            }
          },
          "not": {
            "required": ["error"]
          }
        },
        {
          "required": ["error"],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": ["safe", "may_spend_quota", "no"]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "get_book",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": ["ref", "source", "identifiers", "evidence"],
          "properties": {
            "ref": {
              "type": "string"
            },
            "identifiers": {
              "type": "object"
            },
            "evidence": {
              "type": "object"
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "not": {
            "required": ["error"]
          }
        },
        {
          "required": ["error"],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": ["safe", "may_spend_quota", "no"]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "get_history",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["libgen", "annas", "zlibrary"]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": ["rows"],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "next_cursor": {
              "type": "string"
            }
          },
          "not": {
            "required": ["error"]
          }
        },
        {
          "required": ["error"],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": ["safe", "may_spend_quota", "no"]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "get_limits",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sources": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["libgen", "annas", "zlibrary"]
          },
          "uniqueItems": true
        },
        "mode": {
          "type": "string",
          "enum": ["local", "live"]
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": ["sources"],
          "properties": {
            "sources": {
              "type": "object"
            },
            "default_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "not": {
            "required": ["error"]
          }
        },
        {
          "required": ["error"],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": ["safe", "may_spend_quota", "no"]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "search",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sources": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["libgen", "annas", "zlibrary"]
          },
          "uniqueItems": true
        },
        "exact": {
          "description": "Z-Library only: sent, not checked by this server; other sources are skipped.",
          "type": "boolean"
        },
        "year_from": {
          "description": "Inclusive minimum year; checked on every source. Unknown years are excluded and counted.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "year_to": {
          "description": "Inclusive maximum year; checked on every source. Unknown years are excluded and counted.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "languages": {
          "description": "OR of names/codes; checked on every source. Unknown metadata is excluded. Empty list adds no constraint.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "description": "OR of extensions, case-insensitive, one leading dot ignored; checked on every source. Empty list adds no constraint.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": ["rows", "routing"],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ref", "source"]
              }
            },
            "routing": {
              "type": "object",
              "required": ["requested", "attempts", "fell_back"]
            },
            "next_cursor": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "not": {
            "required": ["error"]
          }
        },
        {
          "required": ["error"],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "code",
                "operation",
                "message",
                "retry",
                "recovery",
                "attempts",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "retry": {
                  "enum": ["safe", "may_spend_quota", "no"]
                },
                "message": {
                  "type": "string"
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  }
]
